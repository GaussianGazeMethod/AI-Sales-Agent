# 复制为 .env；只填写自己的密钥，勿上传 .env。
APP_NAME=AI销售助手展示版
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./showcase.db
# 本地运行前用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成并替换。
SECRET_KEY=replace-with-your-own-random-secret
CORS_ORIGINS=http://127.0.0.1:5230,http://localhost:5230
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 填写你的供应商账户可用且支持当前请求参数的模型名。
DEEPSEEK_MODEL=
